# Copy to .env.docker or export these before docker compose.
# Example: SUGI_APP_PORT=3100 docker compose --env-file .env.docker up --build

SUGI_APP_PORT=3100
SUGI_DB_PORT=5434
SUGI_SESSION_SECRET=replace-with-a-long-random-local-secret
SUGI_DEFAULT_USERNAME=hein
SUGI_DEFAULT_DISPLAY_NAME=Hein
SUGI_DEFAULT_PIN=111111
SUGI_DEFAULT_ROLE=admin
