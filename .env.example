# Prisma runtime connection. Use the application role and a pooled PostgreSQL URL.
# On Supabase/Vercel this must be the transaction pooler on port 6543; local PostgreSQL may use port 5432.
DATABASE_URL=postgresql://sugi_app:replace-me@127.0.0.1:5432/sugi_sale

# Prisma CLI and explicit migrations only. Use the database owner and a direct or session-pooled URL.
# On Supabase this must not use the transaction pooler port 6543; local PostgreSQL may use port 5432.
DIRECT_URL=postgresql://postgres:replace-me@127.0.0.1:5432/sugi_sale

# Docker startup never changes schema or data. Operators run reviewed `prisma migrate deploy`,
# catalog seeding, and any data-repair command explicitly as separate steps with approval.

# Transitional backup and restore scripts. Remove after those scripts use DIRECT_URL.
SIGMA_RAG_PG_DSN=postgresql://sigma_rag@127.0.0.1:5433/sigma_rag

# Required in production. Use a long random value.
SUGI_SESSION_SECRET=change-me-to-a-long-random-secret

# Set false only for private HTTP-over-Tailscale deployment.
# Set true/default when served through HTTPS.
SUGI_COOKIE_SECURE=false

# Optional migration seed user. Override before `npm run migrate`.
SUGI_DEFAULT_USERNAME=staff1
SUGI_DEFAULT_DISPLAY_NAME=Staff 1
SUGI_DEFAULT_PIN=111111
SUGI_DEFAULT_ROLE=user
